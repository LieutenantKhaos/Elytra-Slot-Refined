{
    "schemaVersion": 1,
    "icon": "icon.png",
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_author}"],
    "contact": {
		"sources": "https://github.com/LieutenantKhaos/Elytra-Slot-Refined",
  },
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.warwa.elytraslot.fabric.ElytraSlotFabric"
        ],
        "client": [
            "com.warwa.elytraslot.fabric.ElytraSlotFabricClient"
        ],
        "modmenu": [
            "com.warwa.elytraslot.fabric.ElytraSlotModMenu"
        ]
    },
    "mixins": [
        "elytraslot-common.mixins.json"
    ],
    "accessWidener": "elytraslot.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": ">=${minecraft_version}",
        "fabric-api": "*"
    }
}
